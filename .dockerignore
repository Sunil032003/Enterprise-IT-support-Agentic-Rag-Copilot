# Version control
.git
.gitignore

# Environment and sensitive files (Never include secrets in image)
.env
.env.*
!.env.example

# Python cache and byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Local database and audit artifacts
data/audit.db
uploads/*
!uploads/.gitkeep

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documentation and scratch scripts
test_*.py
test/

