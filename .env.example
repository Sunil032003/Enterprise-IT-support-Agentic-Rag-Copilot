# ==============================================================================
# Enterprise IT Support Agentic RAG Copilot - Environment Configuration
# ==============================================================================

# LLM Provider Configuration ("openrouter" or "gemini")
LLM_PROVIDER=openrouter

# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Google Gemini API Configuration (Used for Pinecone embeddings and optional LLM)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Pinecone Vector Database Configuration
PINECONE_API_KEY=pcsk_your-pinecone-api-key-here
PINECONE_INDEX_NAME=sample-knowledgebase
PINECONE_NAMESPACE=company-it-support

# External Web Search (Tavily)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Groq API Configuration (Optional alternative provider)
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Document Upload & Administration
ADMIN_API_KEY="change me"

# Application Settings
APP_NAME="Enterprise IT Support Agentic RAG Copilot"
APP_ENV=development
